<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game-independent logic (dodge planning, positioning). No package dependencies, so tests run anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Play4ME</RootNamespace>
    <AssemblyName>Play4ME.Core</AssemblyName>
    <Version>0.1.0.0</Version>
  </PropertyGroup>
</Project>
